{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main WebView window. Applies the principle of least privilege: only dialog, opener, limited fs (documents/*.json), and shell open/execute are enabled.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "dialog:default",
    "opener:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "shell:allow-open",
    "shell:allow-execute",
    {
      "identifier": "fs:scope",
      "allow": ["$DOCUMENT/**/*.json"]
    }
  ]
}
